        capability_name: action.toolName || "",
        approval_id: request.requestId,
        approval_wait: { approval_id: request.requestId },
        data: { prompt: request.prompt || "approval required" },
      };
    }
    case "action.result": {
      const action = data.result || {};
      const name = action.toolName || action.name || knownCapabilities.get(action.callId || action.id) || "capability";
      return { ...base, type: "capability.completed", capability_name: name, data: { ok: data.status === "completed" } };
    }
    case "turn.completed":
      return { ...base, type: "run.completed", data: { state: "completed" } };
    case "turn.cancelled":
      return { ...base, type: "run.cancelled", data: { state: "cancelled" } };
    case "turn.failed":
    case "session.failed":
      return { ...base, type: "run.failed", data: { code: "assistant_failed", message: failureMessage(data) } };
    default:
      return null;
  }
}

function normalizeEvents(providerEvent, sessionID, continuationToken, after, fallback, runID) {
  const type = providerEvent?.type;
  const data = providerEvent?.data ?? {};
  if (type === "actions.requested") {
    return (data.actions || [])
      .filter((action) => action?.kind === "tool-call")
      .map((action, index) => {
        knownCapabilities.set(action.callId || action.id, action.toolName);
        return normalizeEvent({ ...providerEvent, data: { ...data, actions: [action] } }, sessionID, continuationToken, after, fallback + index, runID);
      })
      .filter(Boolean);
  }
  if (type === "input.requested") {
    return (data.requests || [])
      .filter((request) => request?.kind === "tool-approval")
      .map((request, index) => normalizeEvent({ ...providerEvent, data: { ...data, requests: [request] } }, sessionID, continuationToken, after, fallback + index, runID))
      .filter(Boolean);
  }
  const normalized = normalizeEvent(providerEvent, sessionID, continuationToken, after, fallback, runID);
  return normalized ? [normalized] : [];
}

async function* providerEvents(stream) {
  const reader = stream.getReader();
  const decoder = new TextDecoder();
  let buffer = "";
  try {
    while (true) {
      const { value, done } = await reader.read();
      if (done) break;
      if (value && typeof value === "object" && !(value instanceof Uint8Array)) {
        yield value;
        continue;
      }
      buffer += decoder.decode(value, { stream: true });
      for (const line of buffer.split("\n").slice(0, -1)) {
       if (line.trim()) yield JSON.parse(line);
     }
      buffer = buffer.slice(buffer.lastIndexOf("\n") + 1);
    }
    buffer += decoder.decode();
    if (buffer.trim()) yield JSON.parse(buffer);
  } finally {
    await reader.cancel().catch(() => {});
  }
}

async function eventStream(request, { attachSession, params, requestIp }) {
  if (!authorized(request, requestIp)) return response({ error: "not found" }, 404);
  shared.attachSession = attachSession;
  const sessionID = params.sessionId;
  const url = new URL(request.url);
  const after = Number(url.searchParams.get("after") || "0");
  if (!Number.isSafeInteger(after) || after < 0) return response({ error: "invalid cursor" }, 400);
  const state = sessionState(sessionID);
  try {
    await catchUp(state, sessionID);
  } catch {
    return response({ error: "not found" }, 404);
  }
  // Every stream reads the session state's one normalized history; only the
  // state reads the provider stream. A stream of a settled session (idle, with
  // no run in progress beyond an unanswered approval) ends after the history;
  // any other stream follows the session until it settles.
  let stopped = false;
  const body = new ReadableStream({
    cancel() {
      // The subscriber left: stop following the session for it. The session
      // state, its runs and other streams are unaffected.
      stopped = true;
    },
    async start(controller) {
      let written = after;
      const flush = () => {
        for (const event of state.history) {
          if (event.sequence > written) {
            controller.enqueue(new TextEncoder().encode(`${JSON.stringify(event)}\n`));
            written = event.sequence;
          }
        }
      };
      try {
        while (!stopped && !request.signal?.aborted) {
          flush();
          if (state.idle && settled(state)) break;
          await new Promise((resolve) => setTimeout(resolve, streamPollMS));
          await catchUp(state, sessionID);
        }
        if (stopped || request.signal?.aborted) {
          return;
        }
        flush();
        controller.close();
      } catch {
        controller.error(new Error("assistant event stream failed"));
      }
    },
  });
  return new Response(body, { headers: ndjsonHeaders });
}

export default defineChannel({
  routes: [
    POST("/scenery/v1/control", control),
    GET("/scenery/v1/control/sessions/:sessionId/events", eventStream),
  ],
});
