  const mcpHost = mcpURLObject.hostname.toLowerCase().replace(/^\[|\]$/g, "");
  const mcpLoopback = mcpHost === "localhost" || mcpHost.endsWith(".localhost") ||
    (isIP(mcpHost) === 4 && mcpHost.startsWith("127.")) || (isIP(mcpHost) === 6 && mcpHost === "::1");
  const mcpPort = Number(mcpURLObject.port);
