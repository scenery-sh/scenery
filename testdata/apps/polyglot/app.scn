application "polyglot" {}

workspace {
  managed_generated_roots = ["pricing/scenerycontract", "typescript/scenerycontract", "mirror/scenerycontract", "native/scenerycontract", "consumer/scenerycontract", "internal/scenerygen", "web/generated"]
}

rust_workspace "application" {
  root = "pricing"
}

rust_toolchain "application" {
  version = "1.99.1"
}

rust_target "development" {
  role      = "development"
  workspace = rust_workspace.application
  toolchain = rust_toolchain.application
}

rust_target "production" {
  role      = "artifact"
  workspace = rust_workspace.application
  toolchain = rust_toolchain.application
}

http_gateway "public_api" {
  exposure       = "internet"
  base_path      = "/api"
  cors           = std.cors.none
  trusted_proxies = std.trusted_proxies.none
  forwarded       = std.forwarded_headers.reject
}

provider "postgres" { source = "registry.scenery.dev/core/postgres" }
provider "durable" { source = "registry.scenery.dev/core/durable" }

data_source "pricing" {
  provider             = provider.postgres
  lifecycle            = "managed"
  require_capabilities = ["sql.query/v1"]
  config               = { database = "pricing" }
}

execution_engine "jobs" {
  provider             = provider.durable
  lifecycle            = "managed"
  require_capabilities = ["execution.durable/v1"]
}

authentication "session" {
  provider = std.provider.standard_auth
  scheme   = "session"
}

module "pricing" {
  source = "./pricing"
  inputs = { gateway = http_gateway.public_api, native = module.native.label_internal, jobs = execution_engine.jobs, session = authentication.session, typescript = module.mirror.echo_internal }
}


go_module "application" {
  root = "."
  import_path = "example.test/polyglot"
}

go_toolchain "application" { version = "1.27.0" }

go_target "development" {
  role      = "development"
  platform  = "host"
  toolchain = go_toolchain.application
  module    = go_module.application
  packages  = ["./..."]
  cgo       = "disabled"
}

module "native" {
  source = "./native"
  inputs = { gateway = http_gateway.public_api, database = data_source.pricing, jobs = execution_engine.jobs }
}

module "consumer" {
  source = "./consumer"
  inputs = {
    gateway = http_gateway.public_api
    quote = module.pricing.quote_internal
    typescript = module.typescript.quote_internal
    session = authentication.session
  }
}

typescript_client "public_api" {
  gateways    = [http_gateway.public_api]
  package     = "@example/polyglot-client"
  module      = "esm"
  runtime     = "fetch"
  output_root = "web/generated"
}

js_workspace "application" { root = "." }
js_toolchain "application" { version = "1.3.14" }

js_target "development" {
  role = "development"
  workspace = js_workspace.application
  toolchain = js_toolchain.application
}

js_target "production" {
  role = "artifact"
  workspace = js_workspace.application
  toolchain = js_toolchain.application
}

module "typescript" {
  source = "./typescript"
  inputs = {
    gateway = http_gateway.public_api
    jobs = execution_engine.jobs
    session = authentication.session
    database = data_source.pricing
    native = module.native.label_internal
    rust = module.pricing.quote_internal
  }
}

module "mirror" {
  source = "./mirror"
  inputs = { gateway = http_gateway.public_api }
}
