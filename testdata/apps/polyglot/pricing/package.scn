package "pricing" {
  rust_contract {
    crate = "pricing"
  }
}

input "gateway" {
  type = resource_ref("http_gateway")
}

input "native" { type = resource_ref("binding") }

service "pricing" {
  runtime = "rust"
  implementation {
    constructor = "NewService"
  }
  client "native" { binding = var.native }
}

record "quote_input" {
  field "amount" { type = int64 }
  field "note" { type = optional(nullable(string)) }
  field "delay_ms" { type = optional(int32) }
}

record "quote_result" {
  field "vendor" { type = string }
  field "amount" { type = int64 }
  field "note" { type = optional(nullable(string)) }
}

operation "quote" {
  service = service.pricing
  input   = record.quote_input
  handler { method = "Quote" }
  result "ok" { type = record.quote_result }
}

execution "quote_direct" {
  operation = operation.quote
  mode      = "direct"
  timeout   = "10s"
}

binding "quote_http" {
  gateway        = var.gateway
  operation      = operation.quote
  execution      = execution.quote_direct
  protocol       = "http"
  delivery       = "call"
  authentication = std.authentication.none
  authorization  = std.authorization.public
  pipeline       = std.pipeline.empty

  http {
    method        = "POST"
    path          = "/quote"
    codec_profile = std.codec.http_json_v1

    body {
      codec = "json"
      to    = operation.quote.input
    }

    response "ok" {
      when   = result.ok
      status = 200
      body {
        codec = "json"
        from  = result.ok
      }
    }
  }
}


binding "quote_internal" {
  operation      = operation.quote
  execution      = execution.quote_direct
  protocol       = "internal"
  exposure       = "application"
  delivery       = "call"
  authentication = std.authentication.inherit
  authorization  = std.authorization.public
  pipeline       = std.pipeline.empty
  internal {
    visibility = "application"
    principal  = "inherit"
  }
}

export "quote_internal" { value = binding.quote_internal }

export "quote" { value = operation.quote }

operation "download" {
  service = service.pricing
  input   = std.type.unit
  handler { method = "Download" }
  result "ok" { type = bytes }
}

execution "download" {
  operation = operation.download
  mode      = "direct"
  timeout   = "10s"
}

binding "download_http" {
  gateway        = var.gateway
  operation      = operation.download
  execution      = execution.download
  protocol       = "http"
  delivery       = "stream"
  authentication = std.authentication.none
  authorization  = std.authorization.public
  pipeline       = std.pipeline.empty
  http {
    method        = "GET"
    path          = "/download"
    codec_profile = std.codec.http_json_v1
    response "ok" {
      when   = result.ok
      status = 200
      body {
        codec = "bytes"
        from  = result.ok
      }
    }
  }
}
