{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.agent.status.schema.json",
  "title": "scenery.agent.status",
  "type": "object",
  "required": [
    "kind",
    "schema_revision",
    "worktrees"
  ],
  "properties": {
    "kind": {
      "const": "scenery.agent.status"
    },
    "schema_revision": {
      "const": "sha256:ea43eb70ac3d2121becb10980dfdb2bcd8dbdbd61575eee60b0e86584332ed1e"
    },
    "worktrees": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "status",
          "sessions"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "app_root": {
            "type": "string"
          },
          "status": {
            "enum": [
              "absent",
              "incompatible-or-invalid",
              "stopped",
              "orphaned",
              "unavailable",
              "running"
            ]
          },
          "sessions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
