{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scenery.agent.status",
  "type": "object",
  "required": [
    "kind",
    "schema_revision",
    "worktrees"
  ],
  "properties": {
    "kind": {
      "const": "scenery.agent.status"
    },
    "schema_revision": {
      "const": "sha256:6d95cc2c2b98f1e7654164d6d82563866dc89f9f225be9eec51fe8928c70ea14"
    },
    "worktrees": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "status",
          "sessions",
          "root_status",
          "source_status",
          "owner_status",
          "metadata_status",
          "source_freshness",
          "serving"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "app_root": {
            "type": "string"
          },
          "status": {
            "enum": [
              "absent",
              "incompatible-or-invalid",
              "stopped",
              "orphaned",
              "unavailable",
              "running"
            ]
          },
          "sessions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "build_blocks": {
            "description": "Present while running sessions of the worktree have builds blocked by a cause no ordinary edit resolves; the runtime keeps serving its last good generation.",
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "schema_revision",
                "spec_revision",
                "session_id",
                "owner",
                "reason",
                "cause",
                "since",
                "prevented_builds"
              ],
              "properties": {
                "kind": {
                  "const": "scenery.dev.build-block"
                },
                "schema_revision": {
                  "type": "string"
                },
                "spec_revision": {
                  "type": "string"
                },
                "producer": {
                  "type": "object"
                },
                "session_id": {
                  "type": "string"
                },
                "owner": {
                  "type": "object"
                },
                "reason": {
                  "enum": [
                    "framework_mismatch",
                    "migration_pending",
                    "seed_changed",
                    "generated_clients_stale"
                  ]
                },
                "cause": {
                  "type": "string"
                },
                "since": {
                  "type": "string",
                  "format": "date-time"
                },
                "prevented_builds": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "root_status": {
            "enum": [
              "present",
              "missing",
              "unavailable",
              "unknown"
            ]
          },
          "source_status": {
            "enum": [
              "present",
              "missing",
              "unavailable",
              "unknown"
            ]
          },
          "owner_status": {
            "enum": [
              "verified_running",
              "stopped",
              "unavailable",
              "unknown"
            ]
          },
          "metadata_status": {
            "enum": [
              "compatible",
              "incompatible-or-invalid",
              "absent",
              "unknown"
            ]
          },
          "source_freshness": {
            "enum": [
              "current",
              "stale",
              "source_missing",
              "blocked",
              "transaction_pending",
              "unknown"
            ],
            "description": "Reported by the verified live owner from its last published source snapshot; current covers runtime watch inputs at observation time, not a business response or UI acceptance. Missing, incompatible or unavailable live evidence remains unknown."
          },
          "serving": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "generation",
                "pid",
                "contract_revision",
                "implementation_revision",
                "build_input_digest",
                "framework_source_digest",
                "source_snapshot_digest",
                "published_at"
              ],
              "properties": {
                "generation": {
                  "type": "integer",
                  "minimum": 0
                },
                "pid": {
                  "type": "string"
                },
                "published_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "contract_revision": {
                  "type": "string"
                },
                "implementation_revision": {
                  "type": "string"
                },
                "build_input_digest": {
                  "type": "string"
                },
                "framework_source_digest": {
                  "type": "string"
                },
                "source_snapshot_digest": {
                  "type": "string"
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "local_agent_start": {
      "description": "Present while the local agent's starts keep failing: one incident of the same executable failing for the same cause.",
      "type": "object",
      "required": [
        "kind",
        "schema_revision",
        "spec_revision",
        "state",
        "class",
        "cause",
        "executable",
        "attempts",
        "first_at",
        "last_at"
      ],
      "properties": {
        "kind": {
          "const": "scenery.agent.start-incident"
        },
        "schema_revision": {
          "type": "string"
        },
        "spec_revision": {
          "type": "string"
        },
        "producer": {
          "type": "object"
        },
        "state": {
          "enum": [
            "retrying",
            "blocked"
          ]
        },
        "class": {
          "enum": [
            "state",
            "owner",
            "configuration",
            "unavailable",
            "other"
          ]
        },
        "cause": {
          "type": "string"
        },
        "executable": {
          "type": "string"
        },
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
        "first_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_at": {
          "type": "string",
          "format": "date-time"
        },
        "next_delay": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$id": "https://scenery.sh/schemas/scenery.agent.status.schema.json"
}
