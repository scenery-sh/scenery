{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.agent.status.schema.json",
  "title": "scenery.agent.status",
  "type": "object",
  "required": [
    "kind",
    "schema_revision",
    "worktrees"
  ],
  "properties": {
    "kind": {
      "const": "scenery.agent.status"
    },
    "schema_revision": {
      "const": "sha256:b5f1d0ec472134aaee60d490423e910967d444d1d3cce4d480f26ef93a8eb476"
    },
    "worktrees": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "status",
          "sessions"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "app_root": {
            "type": "string"
          },
          "status": {
            "enum": [
              "absent",
              "incompatible-or-invalid",
              "stopped",
              "orphaned",
              "unavailable",
              "running"
            ]
          },
          "sessions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "local_agent_start": {
      "description": "Present while the local agent's starts keep failing: one incident of the same executable failing for the same cause.",
      "type": "object",
      "required": [
        "kind",
        "schema_revision",
        "spec_revision",
        "state",
        "class",
        "cause",
        "executable",
        "attempts",
        "first_at",
        "last_at"
      ],
      "properties": {
        "kind": {
          "const": "scenery.agent.start-incident"
        },
        "schema_revision": {
          "type": "string"
        },
        "spec_revision": {
          "type": "string"
        },
        "producer": {
          "type": "object"
        },
        "state": {
          "enum": [
            "retrying",
            "blocked"
          ]
        },
        "class": {
          "enum": [
            "state",
            "owner",
            "configuration",
            "unavailable",
            "other"
          ]
        },
        "cause": {
          "type": "string"
        },
        "executable": {
          "type": "string"
        },
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
        "first_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_at": {
          "type": "string",
          "format": "date-time"
        },
        "next_delay": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
