{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.config.change.schema.json",
  "title": "scenery environment configuration changes",
  "type": "object",
  "required": [
    "kind",
    "schema_revision",
    "app_id",
    "environment",
    "key",
    "operation",
    "changed",
    "previous_revision",
    "revision",
    "missing",
    "application"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "scenery.config.change"
    },
    "schema_revision": {
      "const": "sha256:d30fbfac6fdf016564149921b12c01773f0792df5ca4061597ba0a0d8264d774"
    },
    "app_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
    },
    "environment": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "operation": {
      "enum": [
        "set",
        "unset",
        "migrate_connections"
      ]
    },
    "changed": {
      "type": "boolean"
    },
    "previous_revision": {
      "type": "string",
      "pattern": "^cfg-[0-9a-f]{32}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^cfg-[0-9a-f]{32}$"
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
      }
    },
    "application": {
      "type": "string",
      "minLength": 1
    }
  }
}
