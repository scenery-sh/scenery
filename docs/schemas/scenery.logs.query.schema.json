{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.logs.query.schema.json",
  "title": "scenery.logs.query",
  "type": "object",
  "required": [
    "kind",
    "schema_revision",
    "scope",
    "backend",
    "query",
    "logs"
  ],
  "properties": {
    "kind": {
      "const": "scenery.logs.query"
    },
    "schema_revision": {
      "const": "sha256:56c91a3d7193c11445dfd09cfc6e98ed3fa4a9c1ac1f4f5042b3ee73d811c9b1"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "backend": {
      "$ref": "#/$defs/backend"
    },
    "query": {
      "$ref": "#/$defs/query"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "logs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/log"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "scope": {
      "type": "object",
      "required": [
        "app_id",
        "session_id",
        "app_root",
        "app_root_hash",
        "enforced"
      ],
      "properties": {
        "app_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "app_root": {
          "type": "string"
        },
        "app_root_hash": {
          "type": "string"
        },
        "worktree": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "enforced": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "backend": {
      "type": "object",
      "required": [
        "kind",
        "dialect",
        "ready"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "dialect": {
          "type": "string"
        },
        "base_url": {
          "type": "string"
        },
        "ready": {
          "type": "boolean"
        },
        "query_path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "required": [
        "query",
        "start",
        "end"
      ],
      "properties": {
        "query": {
          "type": "string"
        },
        "since": {
          "type": "string"
        },
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "limit": {
          "type": "integer"
        },
        "timeout": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "log": {
      "type": "object",
      "properties": {
        "time": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "fields": {
          "type": "object"
        },
        "trace_id": {
          "type": "string"
        },
        "span_id": {
          "type": "string"
        },
        "raw": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
