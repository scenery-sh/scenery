{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.snapshot.manifest.schema.json",
  "title": "Scenery snapshot manifest",
  "type": "object",
  "required": ["kind", "schema_revision", "created_at", "app", "files"],
  "properties": {
    "kind": { "const": "scenery.snapshot.manifest" },
    "schema_revision": { "const": "sha256:6885a140ff0b5b20f4639d1837609b28bb28735e803c7ce80561c49401654e87" },
    "created_at": { "type": "string", "format": "date-time" },
    "app": {
      "type": "object",
      "required": ["name", "id"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "db": {
      "type": "object",
      "required": ["database", "source", "schemas", "dump_file", "dump_format"],
      "properties": {
        "database": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "enum": ["managed", "external"] },
        "schemas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["service", "schema"],
            "properties": {
              "service": { "type": "string", "minLength": 1 },
              "schema": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "dump_file": { "const": "db/database.postgres.dump" },
        "dump_format": { "const": "pg_custom" }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "required": ["stores"],
      "properties": {
        "provenance": {
          "type": "object",
          "required": ["app_root", "worktree_key"],
          "properties": {
            "app_root": { "type": "string" },
            "worktree_key": { "type": "string" }
          },
          "additionalProperties": false
        },
        "stores": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "files", "bytes", "manifest"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "files": { "type": "integer", "minimum": 0 },
              "bytes": { "type": "integer", "minimum": 0 },
              "manifest": { "$ref": "#/$defs/file" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "maxItems": 1,
      "description": "Only the database dump appears here. Storage inventory is streamed from each checksummed JSONL store manifest.",
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "$defs": {
    "file": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "additionalProperties": false
    },
    "object": {
      "type": "object",
      "description": "One JSONL store-manifest record. UTF-8 byte bounds and the 16 KiB encoded metadata bound are checked by the archive reader. Source ETags and internal storage paths are not portable.",
      "required": ["store", "key", "size_bytes", "sha256", "modified_at"],
      "properties": {
        "store": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
        "tenant": { "type": "string", "maxLength": 256 },
        "key": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "content_type": { "type": "string", "maxLength": 255 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "modified_at": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "anyOf": [{ "required": ["db"] }, { "required": ["storage"] }],
  "additionalProperties": false
}
