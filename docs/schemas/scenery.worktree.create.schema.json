{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.worktree.create.schema.json",
  "title": "scenery worktree create result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_revision",
    "ok",
    "name",
    "path",
    "branch",
    "next_command"
  ],
  "properties": {
    "kind": {
      "const": "scenery.worktree.create"
    },
    "schema_revision": {
      "const": "sha256:e7bd934a2ad675a247e3ed5cc11dafb569e2ab7d4ec7180bdeddc55a4a77f49f"
    },
    "ok": {
      "type": "boolean"
    },
    "name": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "from": {
      "type": "string"
    },
    "next_command": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "method"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "method": {
            "enum": [
              "clone",
              "copy"
            ]
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "template",
        "template_hit",
        "cloned",
        "clone_ms"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "template": {
          "type": "string"
        },
        "template_hit": {
          "type": "boolean"
        },
        "cloned": {
          "type": "boolean"
        },
        "clone_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "message": {
      "type": "string"
    }
  }
}
