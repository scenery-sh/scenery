{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.snapshot.load.schema.json",
  "title": "scenery snapshot load",
  "type": "object",
  "required": [
    "kind",
    "schema_revision",
    "archive",
    "app",
    "mode",
    "dry_run"
  ],
  "properties": {
    "kind": {
      "const": "scenery.snapshot.load"
    },
    "schema_revision": {
      "const": "sha256:37f665657dc93df8f00a36e6e1237fb2ae08be6844a287964cf775bbca176216"
    },
    "archive": {
      "type": "string",
      "minLength": 1
    },
    "app": {
      "$ref": "scenery.snapshot.save.schema.json#/$defs/app"
    },
    "mode": {
      "type": "string",
      "enum": [
        "overwrite",
        "merge"
      ]
    },
    "dry_run": {
      "type": "boolean"
    },
    "db": {
      "allOf": [
        {
          "$ref": "scenery.snapshot.save.schema.json#/$defs/db"
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "enum": [
                "overwrite",
                "merge"
              ]
            }
          }
        }
      ]
    },
    "storage": {
      "$ref": "scenery.snapshot.save.schema.json#/$defs/storage"
    }
  },
  "anyOf": [
    {
      "required": [
        "db"
      ]
    },
    {
      "required": [
        "storage"
      ]
    }
  ],
  "additionalProperties": false,
  "description": "Pinned logical import into a stopped worktree. Method and conflict counters are reported when staging runs, and are not reconstructed for an already-staged resume."
}
