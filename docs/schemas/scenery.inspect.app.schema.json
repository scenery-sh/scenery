{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.inspect.app.schema.json",
  "title": "scenery.inspect.app",
  "type": "object",
  "required": [
    "kind",
    "schema_revision",
    "app",
    "config",
    "counts",
    "services",
    "sql_requirements"
  ],
  "properties": {
    "kind": {
      "const": "scenery.inspect.app"
    },
    "schema_revision": {
      "const": "sha256:9bd1a90b627a705febdb9bbf96bc3f4ddb2abd126ff5879c5afc1a51967a384d"
    },
    "app": {
      "$ref": "#/$defs/appRef"
    },
    "config": {
      "$ref": "scenery.config.schema.json"
    },
    "counts": {
      "type": "object",
      "required": [
        "packages",
        "services",
        "endpoints",
        "middleware",
        "auth_handler",
        "runtime_declarations"
      ],
      "properties": {
        "packages": {
          "type": "integer",
          "minimum": 0
        },
        "services": {
          "type": "integer",
          "minimum": 0
        },
        "endpoints": {
          "type": "integer",
          "minimum": 0
        },
        "middleware": {
          "type": "integer",
          "minimum": 0
        },
        "auth_handler": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_declarations": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sql_requirements": {
      "description": "Current compiled SQL requirements, not supply endpoints or retained allocations. Empty for an application without local SQL requirements.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "capabilities", "name", "schema", "lifecycle", "consumers", "origin"],
        "properties": {
          "kind": {"enum": ["data_source", "standard_auth", "durable_execution"]},
          "address": {"type": "string", "minLength": 1},
          "config_path": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "capabilities": {"type": "array", "items": {"type": "string"}},
          "name": {"type": "string", "minLength": 1},
          "schema": {"type": "string", "minLength": 1, "maxLength": 63},
          "lifecycle": {"enum": ["managed", "external", "attached", "ephemeral"]},
          "consumers": {"type": "array", "items": {"type": "string"}},
          "origin": {"type": "object"}
        },
        "oneOf": [
          {"required": ["address"], "properties": {"kind": {"enum": ["data_source", "durable_execution"]}}},
          {"required": ["config_path"], "properties": {"kind": {"const": "standard_auth"}}}
        ],
        "additionalProperties": false
      }
    },
    "auth_handler": {
      "type": "object",
      "required": [
        "service",
        "name"
      ],
      "properties": {
        "service": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "appRef": {
      "type": "object",
      "required": [
        "name",
        "root",
        "config_path"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "root": {
          "type": "string"
        },
        "config_path": {
          "type": "string"
        },
        "module_path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
