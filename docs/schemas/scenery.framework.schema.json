{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.framework.schema.json",
  "title": "Scenery Framework Selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_revision", "ok", "app_root", "mode", "framework_version", "executable", "executable_digest", "selection_path", "module_changed", "next_command"],
  "properties": {
    "kind": { "const": "scenery.framework" },
    "schema_revision": { "const": "sha256:0cb384386033ff4642a699be3cf9044e17f4f46b33d7a528f303296e38c535b8" },
    "ok": { "type": "boolean" },
    "app_root": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["pinned", "source", "linked", "runtime", "prebuilt"] },
    "framework_version": { "type": "string", "minLength": 1 },
    "source_root": { "type": "string", "minLength": 1 },
    "source_origin": { "type": "string", "minLength": 1 },
    "source_digest": { "$ref": "#/$defs/digest" },
    "source_revision": { "type": "string" },
    "executable": { "type": "string", "minLength": 1 },
    "executable_digest": { "$ref": "#/$defs/digest" },
    "selection_path": { "type": "string", "minLength": 1 },
    "module_changed": { "type": "boolean" },
    "next_command": { "type": "string", "minLength": 1 }
  },
  "if": { "properties": { "mode": { "const": "prebuilt" } } },
  "then": {
    "properties": {
      "source_root": false,
      "source_origin": false,
      "source_digest": false,
      "source_revision": false,
      "module_changed": { "const": false }
    }
  },
  "else": { "required": ["source_root", "source_digest"] },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
