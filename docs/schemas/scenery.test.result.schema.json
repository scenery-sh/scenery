{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.test.result.schema.json",
  "title": "scenery.test.result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_revision",
    "ok",
    "app_root",
    "modules",
    "duration_ms"
  ],
  "properties": {
    "kind": {
      "const": "scenery.test.result"
    },
    "schema_revision": {
      "const": "sha256:c7c11072a2ceb3fafbd1ddc7637cd24726a4e16168856dd4f028f0e6d7b860e8"
    },
    "ok": {
      "type": "boolean"
    },
    "app_root": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module",
          "directory",
          "runtime",
          "command",
          "ok",
          "duration_ms"
        ],
        "properties": {
          "module": {
            "type": "string"
          },
          "directory": {
            "type": "string"
          },
          "runtime": {
            "enum": [
              "go",
              "rust",
              "ts",
              "js",
              "python"
            ]
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ok": {
            "type": "boolean"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "output": {
            "type": "string"
          },
          "database": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "template",
              "clone_ms"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "template": {
                "type": "string"
              },
              "clone_ms": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "database_template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "template_hit",
        "setup_ms"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "template_hit": {
          "type": "boolean"
        },
        "setup_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "test_host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "startup_ms"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "startup_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
