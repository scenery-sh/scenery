{
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "schema_revision": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "path",
        "exists"
      ],
      "type": "object"
    },
    "changed_area": {
      "additionalProperties": false,
      "properties": {
        "affected_packages": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "changed_files": {
          "items": {
            "$ref": "#/$defs/changed_file"
          },
          "type": "array"
        },
        "diagnostics": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        },
        "ignored_files": {
          "items": {
            "$ref": "#/$defs/changed_file"
          },
          "type": "array"
        },
        "kind": {
          "const": "scenery.harness.changed_area"
        },
        "recommended_commands": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "relevant_docs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "risk_flags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "schema_revision": {
          "const": "sha256:a7240232c8378e835cac0ec4fa6f9a9236b5988ec7692d1988d43edbf5a73b0f"
        },
        "validation_classes": {
          "items": {
            "enum": [
              "documentation-only",
              "go-package",
              "cli-json-contract",
              "compiler-or-generator",
              "ui-catalog",
              "release-sensitive-or-runtime",
              "repository-fallback"
            ]
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "schema_revision",
        "changed_files",
        "affected_packages",
        "validation_classes",
        "recommended_commands",
        "relevant_docs",
        "risk_flags"
      ],
      "type": "object"
    },
    "changed_file": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "status",
        "category"
      ],
      "type": "object"
    },
    "evidence": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/evidence_artifact"
          },
          "type": "array"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cwd": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer"
        },
        "exit_code": {
          "type": "integer"
        },
        "kind": {
          "const": "scenery.harness.artifact"
        },
        "repro_command": {
          "type": "string"
        },
        "schema_revision": {
          "const": "sha256:5fdbd3fbabd171b9226331c8d821c2a59744e7682943593896c332b8ac69eaa8"
        },
        "started_at": {
          "type": "string"
        },
        "stderr_tail": {
          "type": "string"
        },
        "stdout_tail": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "schema_revision",
        "duration_ms"
      ],
      "type": "object"
    },
    "evidence_artifact": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "schema_revision": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "path"
      ],
      "type": "object"
    },
    "knowledge_file": {
      "additionalProperties": false,
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "exists"
      ],
      "type": "object"
    },
    "schema_validation": {
      "additionalProperties": false,
      "properties": {
        "diagnostics": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        },
        "kind": {
          "const": "scenery.harness.schema_validation"
        },
        "schema_revision": {
          "const": "sha256:0918839b24308f0f76a77333a3046fac7030513faef6d1ce3345bb3e34dbf0f1"
        },
        "validated": {
          "items": {
            "$ref": "#/$defs/schema_validation_item"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "schema_revision",
        "validated"
      ],
      "type": "object"
    },
    "schema_validation_item": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "schema": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "schema",
        "ok"
      ],
      "type": "object"
    },
    "step": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "diagnostics": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        },
        "duration_ms": {
          "type": "integer"
        },
        "effects": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "error": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "name": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "output_tail": {
          "type": "string"
        },
        "summary": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "name",
        "command",
        "ok",
        "duration_ms"
      ],
      "type": "object"
    }
  },
  "$id": "https://scenery.sh/schemas/scenery.harness.self.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "type": "array"
    },
    "changed_area": {
      "$ref": "#/$defs/changed_area"
    },
    "drift": {
      "additionalProperties": true,
      "type": "object"
    },
    "fixture_matrix": {
      "additionalProperties": true,
      "type": "object"
    },
    "generated_at": {
      "type": "string"
    },
    "kind": {
      "const": "scenery.harness.self"
    },
    "knowledge": {
      "additionalProperties": false,
      "properties": {
        "entrypoints": {
          "items": {
            "$ref": "#/$defs/knowledge_file"
          },
          "type": "array"
        },
        "schemas": {
          "items": {
            "$ref": "#/$defs/knowledge_file"
          },
          "type": "array"
        }
      },
      "required": [
        "entrypoints",
        "schemas"
      ],
      "type": "object"
    },
    "mode": {
      "enum": [
        "default",
        "quick",
        "race",
        "release",
        "probe",
        "benchmark"
      ]
    },
    "next_actions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "ok": {
      "type": "boolean"
    },
    "producer": {
      "$ref": "scenery.cli.schema.json#/$defs/producer"
    },
    "repo": {
      "additionalProperties": false,
      "properties": {
        "go_mod_path": {
          "type": "string"
        },
        "module_path": {
          "const": "scenery.sh"
        },
        "root": {
          "type": "string"
        }
      },
      "required": [
        "root",
        "module_path",
        "go_mod_path"
      ],
      "type": "object"
    },
    "run": {
      "additionalProperties": false,
      "properties": {
        "archive_path": {
          "type": "string"
        },
        "final_input_revision": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "input_revision": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "inputs_stable": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "input_revision",
        "final_input_revision",
        "inputs_stable"
      ],
      "type": "object"
    },
    "schema_revision": {
      "const": "sha256:2560d2d766de7573a42afad53db3d1c795a9eec1a064488b8ff12b5f4395248d"
    },
    "schema_validation": {
      "$ref": "#/$defs/schema_validation"
    },
    "spec_revision": {
      "$ref": "scenery.cli.schema.json#/$defs/revision"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/step"
      },
      "type": "array"
    },
    "test_timing": {
      "$ref": "scenery.harness.test_timing.schema.json"
    },
    "toolchain": {
      "additionalProperties": true,
      "type": "object"
    },
    "verification": {
      "$ref": "scenery.harness.verification.schema.json"
    },
    "wrote": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "schema_revision",
    "ok",
    "generated_at",
    "mode",
    "repo",
    "knowledge",
    "steps",
    "artifacts",
    "run",
    "spec_revision",
    "producer"
  ],
  "title": "scenery self harness result",
  "type": "object"
}
