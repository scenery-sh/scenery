{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.context.schema.json",
  "title": "scenery.context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_revision",
    "module",
    "directory",
    "runtime",
    "sources",
    "generated_contract_root",
    "services",
    "operations",
    "types",
    "routes",
    "internal_bindings",
    "durable_executions",
    "schedules",
    "events",
    "publishers",
    "subscriptions",
    "dependencies",
    "commands"
  ],
  "properties": {
    "kind": {
      "const": "scenery.context"
    },
    "schema_revision": {
      "const": "sha256:3d375758f8db4da8f492ad607a5fe0ef2a64c1916a1ed6402c2891903c188d26"
    },
    "module": {
      "type": "string"
    },
    "directory": {
      "type": "string"
    },
    "runtime": {
      "enum": [
        "go",
        "rust",
        "ts",
        "js",
        "python"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_contract_root": {
      "type": "string"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "binding",
          "operation",
          "method",
          "path",
          "authentication",
          "authorization"
        ],
        "properties": {
          "binding": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "authentication": {
            "type": "string"
          },
          "authorization": {
            "type": "string"
          }
        }
      }
    },
    "internal_bindings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "durable_executions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "schedules": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "events": {
      "type": "array",
      "items": { "type": "object" }
    },
    "publishers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "name", "event"],
        "properties": {
          "service": { "type": "string" },
          "name": { "type": "string" },
          "event": { "type": "string" }
        }
      }
    },
    "subscriptions": {
      "type": "array",
      "items": { "type": "object" }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clients",
        "sql",
        "config_inputs",
        "auth_policies"
      ],
      "properties": {
        "clients": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "service",
              "name",
              "binding",
              "callee",
              "runtime"
            ],
            "properties": {
              "service": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "binding": {
                "type": "string"
              },
              "callee": {
                "type": "string"
              },
              "runtime": {
                "enum": [
                  "go",
                  "rust",
                  "ts",
                  "js",
                  "python"
                ]
              }
            }
          }
        },
        "sql": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "config_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auth_policies": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "types": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
