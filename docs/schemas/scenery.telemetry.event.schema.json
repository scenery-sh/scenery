{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.telemetry.event.schema.json",
  "type": "object",
  "required": ["at", "kind"],
  "additionalProperties": false,
  "properties": {
    "at": {"type": "string", "format": "date-time"},
    "kind": {"enum": ["rebuild", "worker_fault", "proxy_fault", "runtime_fault"]},
    "generation": {"type": "integer", "minimum": 0},
    "app": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "rebuild": {
      "type": "object",
      "required": ["detect_ms", "compile_ms", "link_ms", "ready_ms", "rebuilt_modules", "skipped_modules", "trigger_kind", "ok"],
      "additionalProperties": false,
      "properties": {
        "edit_to_ready_ms": {"type": "number", "minimum": 0},
        "detect_ms": {"type": "number", "minimum": 0},
        "compile_ms": {"type": "number", "minimum": 0},
        "link_ms": {"type": "number", "minimum": 0},
        "ready_ms": {"type": "number", "minimum": 0},
        "rebuilt_modules": {"type": "array", "items": {"type": "string"}},
        "skipped_modules": {"type": "array", "items": {"type": "string"}},
        "trigger_kind": {"enum": ["body_only", "contract_or_config"]},
        "trigger_buckets": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "ok": {"type": "boolean"},
        "error_code": {"type": "string"}
      }
    },
    "worker_fault": {
      "type": "object",
      "required": ["module", "runtime", "exit_code"],
      "additionalProperties": false,
      "properties": {
        "module": {"type": "string", "minLength": 1},
        "runtime": {"enum": ["go", "rust", "ts", "js", "python"]},
        "exit_code": {"type": "integer"},
        "signal": {"type": "string"}
      }
    },
    "proxy_fault": {
      "type": "object",
      "required": ["backend", "status", "error_class"],
      "additionalProperties": false,
      "properties": {
        "backend": {"type": "string", "minLength": 1},
        "status": {"type": "integer", "minimum": 400, "maximum": 599},
        "error_class": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "minLength": 1}
      }
    },
    "runtime_fault": {
      "type": "object",
      "required": ["component", "error_class"],
      "additionalProperties": false,
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "target": {"type": "string"},
        "error_class": {"type": "string", "minLength": 1}
      }
    }
  },
  "oneOf": [
    {"properties": {"kind": {"const": "rebuild"}, "generation": {"minimum": 1}}, "required": ["generation", "rebuild"], "not": {"anyOf": [{"required": ["worker_fault"]}, {"required": ["proxy_fault"]}, {"required": ["runtime_fault"]}]}},
    {"properties": {"kind": {"const": "worker_fault"}, "generation": {"minimum": 1}}, "required": ["generation", "worker_fault"], "not": {"anyOf": [{"required": ["rebuild"]}, {"required": ["proxy_fault"]}, {"required": ["runtime_fault"]}]}},
    {"properties": {"kind": {"const": "proxy_fault"}}, "required": ["proxy_fault"], "not": {"anyOf": [{"required": ["rebuild"]}, {"required": ["worker_fault"]}, {"required": ["runtime_fault"]}]}},
    {"properties": {"kind": {"const": "runtime_fault"}}, "required": ["runtime_fault"], "not": {"anyOf": [{"required": ["rebuild"]}, {"required": ["worker_fault"]}, {"required": ["proxy_fault"]}]}}
  ]
}
