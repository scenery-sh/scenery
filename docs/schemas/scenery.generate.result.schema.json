{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.generate.result.schema.json",
  "title": "scenery generate CLI data",
  "type": "object",
  "required": ["target", "generation", "clients", "editor_workspace"],
  "additionalProperties": false,
  "properties": {
    "target": {"type": "string"},
    "generation": {
      "type": "object",
      "required": ["changed", "checked"],
      "additionalProperties": false,
      "properties": {
        "changed": {"type": ["array", "null"], "items": {"type": "string"}},
        "checked": {"type": ["array", "null"], "items": {"type": "string"}}
      }
    },
    "clients": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "bindings"],
        "additionalProperties": false,
        "properties": {
          "target": {"type": "string"},
          "bindings": {"type": "integer", "minimum": 0},
          "message": {"type": "string"}
        }
      }
    },
    "editor_workspace": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["managed", "skipped", "not_requested", "conflict"]},
        "reason": {"type": "string"},
        "work_file": {"type": "string"}
      }
    }
  }
}
