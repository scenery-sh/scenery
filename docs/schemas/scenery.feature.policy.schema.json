{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "probe_limit",
    "development",
    "landing"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "probe_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "development": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "landing": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.feature.policy.schema.json",
  "title": "Repository local feature validation policy",
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command",
        "args"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expensive": {
          "type": "boolean"
        },
        "reuse": {
          "type": "boolean"
        },
        "when_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
