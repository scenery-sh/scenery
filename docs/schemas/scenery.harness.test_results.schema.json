            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "todo",
              "timed_out",
              "canceled",
              "blocked",
              "incomplete",
              "not_selected"
