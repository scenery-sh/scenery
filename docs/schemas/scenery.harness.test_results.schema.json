      "enum": [
        "passed",
        "failed",
        "skipped",
        "todo",
        "timed_out",
        "canceled",
        "blocked",
        "incomplete",
        "not_selected"
      ]
    },
    "parent_run_id": {
      "type": "string"
    },
    "producer": {
      "$ref": "scenery.cli.schema.json#/$defs/producer"
    },
    "purpose": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "runner": {
      "type": "string"
    },
    "runner_version": {
      "type": "string"
    },
    "schema_revision": {
      "const": "sha256:942678c71de92263ea889e580240c1bd68fbb90b33abda846c4b3fd534416e7c"
    },
    "selected_files": {
      "items": {
        "type": "string"
      },
