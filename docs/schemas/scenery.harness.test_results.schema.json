    "lane",
    "runner",
    "runner_version",
    "os",
    "architecture",
    "cwd",
    "context",
    "outcome",
    "command",
    "selected_files",
    "wall_seconds",
    "attempt",
    "completeness",
    "cases",
    "artifacts",
    "unknown_stages",
    "spec_revision",
    "producer"
