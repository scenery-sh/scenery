{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.storage.object.schema.json",
  "title": "scenery.storage.object",
  "type": "object",
  "required": [
    "kind",
    "schema_revision",
    "scope",
    "object"
  ],
  "properties": {
    "kind": {
      "const": "scenery.storage.object"
    },
    "schema_revision": {
      "const": "sha256:7b11f31427314372866fb634d42e96ce92630096b61eb2eff4fa3f79c91fc5a9"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "object": {
      "$ref": "#/$defs/object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "scope": {
      "type": "object",
      "required": [
        "app_id",
        "app_root",
        "worktree_key",
        "incarnation",
        "generation"
      ],
      "properties": {
        "app_id": {
          "type": "string",
          "minLength": 1
        },
        "app_root": {
          "type": "string",
          "minLength": 1
        },
        "worktree_key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "incarnation": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{32}$"
        },
        "generation": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{32}$"
        },
        "store": {
          "type": "string"
        },
        "tenant": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "totals": {
      "type": "object",
      "required": [
        "objects",
        "bytes"
      ],
      "properties": {
        "objects": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "required": [
        "store",
        "key",
        "size_bytes",
        "etag",
        "sha256",
        "modified_at"
      ],
      "properties": {
        "store": {
          "type": "string"
        },
        "tenant": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "content_type": {
          "type": "string"
        },
        "etag": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "modified_at": {
          "type": "string",
          "format": "date-time"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
