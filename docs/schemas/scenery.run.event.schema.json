{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.run.event.schema.json",
  "title": "scenery.run.event",
  "description": "Event payload schema emitted under `scenery.cli.event` by `scenery up -o jsonl`.",
  "type": "object",
  "required": [
    "kind",
    "schema_revision",
    "type",
    "time"
  ],
  "properties": {
    "kind": {
      "const": "scenery.run.event"
    },
    "schema_revision": {
      "const": "sha256:783d6c49d9a0f2b57acebc0d1c11f9e155a7b2d9a3c70bc171f4a7d48e6d8138"
    },
    "type": {
      "type": "string"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "app": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "root": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "diagnostic": {
          "$ref": "scenery.cli.schema.json#/$defs/diagnostic"
        },
        "exit_code": {
          "enum": [1, 2, 3, 4, 5, 10]
        }
      }
    }
  },
  "additionalProperties": false
}
