{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.db.server.status.schema.json",
  "title": "scenery db server status",
  "type": "object",
  "required": [
    "kind",
    "schema_revision",
    "ok",
    "container",
    "status",
    "app_root",
    "scope",
    "retained_data"
  ],
  "properties": {
    "kind": {
      "const": "scenery.db.server.status"
    },
    "schema_revision": {
      "const": "sha256:859372bc8b167d297b8b14fc48e912a66d9d09485749ddff366c1ef4d9f43ba9"
    },
    "ok": {
      "type": "boolean"
    },
    "container": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "port": {
      "type": "integer"
    },
    "url": {
      "type": "string"
    },
    "state_path": {
      "type": "string"
    },
    "databases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "app_root": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "worktree",
        "external"
      ]
    },
    "retained_data": {
      "type": "boolean"
    },
    "resource_id": {
      "type": "string"
    },
    "restore": {
      "type": "object",
      "required": [
        "archive_sha256",
        "archive_path",
        "mode",
        "sql_started"
      ],
      "properties": {
        "archive_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "archive_path": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "overwrite",
            "merge"
          ]
        },
        "sql_started": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
