{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.storage.inspect.schema.json",
  "title": "scenery.storage.inspect",
  "type": "object",
  "required": [
    "kind",
    "schema_revision",
    "app",
    "storage",
    "stores"
  ],
  "properties": {
    "kind": {
      "const": "scenery.storage.inspect"
    },
    "schema_revision": {
      "const": "sha256:2a3f8176b64c077ad30bcd93ffca3009edf23d924d9f24caa06c48901dc774f8"
    },
    "app": {
      "type": "object",
      "required": [
        "name",
        "root",
        "config_path"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "root": {
          "type": "string"
        },
        "config_path": {
          "type": "string"
        },
        "module_path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "required": [
        "configured",
        "declared",
        "readiness",
        "scope"
      ],
      "properties": {
        "configured": {
          "type": "boolean"
        },
        "declared": {
          "type": "boolean"
        },
        "default": {
          "type": "string"
        },
        "readiness": {
          "enum": [
            "not_configured",
            "uninitialized",
            "ready",
            "retired",
            "recovery_required"
          ]
        },
        "scope": {
          "$ref": "scenery.storage.object.schema.json#/$defs/scope"
        },
        "browser_url": {
          "type": "string"
        },
        "recovery": {
          "type": "object",
          "required": [
            "operation",
            "database",
            "storage",
            "phase",
            "resume"
          ],
          "properties": {
            "operation": {
              "enum": [
                "restore",
                "purge"
              ]
            },
            "archive_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "selection_revision": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "mode": {
              "enum": [
                "merge",
                "overwrite"
              ]
            },
            "on_conflict": {
              "enum": [
                "fail",
                "skip",
                "overwrite"
              ]
            },
            "database": {
              "type": "boolean"
            },
            "storage": {
              "type": "boolean"
            },
            "phase": {
              "enum": [
                "prepared",
                "retired",
                "preparing",
                "staged",
                "database",
                "switched"
              ]
            },
            "resume": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "totals": {
          "type": "object",
          "required": [
            "objects",
            "bytes"
          ],
          "properties": {
            "objects": {
              "type": "integer",
              "minimum": 0
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "stores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "access",
          "tenant_scoped"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "local"
            ]
          },
          "access": {
            "type": "string",
            "enum": [
              "auth",
              "private"
            ]
          },
          "tenant_scoped": {
            "type": "boolean"
          },
          "max_object_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "object_count": {
            "type": "integer",
            "minimum": 0
          },
          "total_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "description": "Read-only retained worktree discovery. Exact totals are optional and computed only by an explicit metadata scan."
}
