{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.failure.report.schema.json",
  "title": "scenery.failure.report",
  "type": "object",
  "required": [
    "kind",
    "schema_revision",
    "report_token",
    "code",
    "recorded_at",
    "command",
    "arguments",
    "working_directory",
    "cause",
    "producer_version",
    "origin"
  ],
  "properties": {
    "kind": {
      "const": "scenery.failure.report"
    },
    "schema_revision": {
      "const": "sha256:ec51eafe6a9509fb64eb243d8d91b4da4d646b134a7699fbb2dfab9f7b42ab36"
    },
    "report_token": {
      "type": "string",
      "pattern": "^rpt_[a-z0-9]+$"
    },
    "code": {
      "type": "string"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "command": {
      "type": "string"
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "working_directory": {
      "type": "string"
    },
    "cause": {
      "type": "string"
    },
    "producer_version": {
      "type": "string"
    },
    "origin": {
      "enum": [
        "cli",
        "runtime"
      ]
    },
    "reporter_pid": {
      "type": "integer"
    },
    "app_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "runtime",
        "service",
        "operation",
        "mode",
        "contract_revision",
        "generation",
        "trace_id"
      ],
      "properties": {
        "module": {
          "type": "string"
        },
        "runtime": {
          "enum": [
            "go",
            "rust",
            "ts",
            "js",
            "python"
          ]
        },
        "service": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "binding": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "http_method": {
          "type": "string"
        },
        "http_path": {
          "type": "string"
        },
        "http_body": {},
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "principal": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "contract_revision": {
          "type": "string"
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "trace_id": {
          "type": "string"
        },
        "input": {},
        "input_truncated": {
          "type": "boolean"
        }
      }
    }
  },
  "additionalProperties": false
}
