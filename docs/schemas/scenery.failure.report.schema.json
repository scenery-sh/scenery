{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.failure.report.schema.json",
  "title": "scenery.failure.report",
  "type": "object",
  "required": [
    "kind",
    "schema_revision",
    "report_token",
    "code",
    "recorded_at",
    "command",
    "arguments",
    "working_directory",
    "cause",
    "producer_version",
    "origin"
  ],
  "properties": {
    "kind": {
      "const": "scenery.failure.report"
    },
    "schema_revision": {
      "const": "sha256:4d4540496d4ad6467a4d1ff95b00228858e088a6da619310a057ab6ffbd9e273"
    },
    "report_token": {
      "type": "string",
      "pattern": "^rpt_[a-z0-9]+$"
    },
    "code": {
      "type": "string"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "command": {
      "type": "string"
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "working_directory": {
      "type": "string"
    },
    "cause": {
      "type": "string"
    },
    "producer_version": {
      "type": "string"
    },
    "origin": {
      "enum": [
        "cli",
        "runtime"
      ]
    },
    "reporter_pid": {
      "type": "integer"
    },
    "app_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
