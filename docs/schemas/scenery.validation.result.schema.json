{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.validation.result.schema.json",
  "title": "scenery.validation.result",
  "type": "object",
  "required": [
    "kind",
    "schema_revision",
    "ok",
    "generated_at",
    "app",
    "profile",
    "selection",
    "steps",
    "run",
    "plan",
    "dry_run",
    "outcome",
    "executed_steps",
    "selected_steps",
    "omitted_steps",
    "unknown_stages",
    "spec_revision",
    "producer"
  ],
  "properties": {
    "kind": {
      "const": "scenery.validation.result"
    },
    "schema_revision": {
      "const": "sha256:139558e468ee2afaf721b0f1a1b4b1fde798cd6f98748af96246c8fa6de2e0da"
    },
    "ok": {
      "type": "boolean"
    },
    "generated_at": {
      "type": "string"
    },
    "app": {
      "type": "object",
      "additionalProperties": true
    },
    "profile": {
      "type": "string"
    },
    "selection": {
      "$ref": "scenery.validation.plan.schema.json#/$defs/selection"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "wrote": {
      "type": "string"
    },
    "dry_run": {
      "type": "boolean"
    },
    "executed_steps": {
      "minimum": 0,
      "type": "integer"
    },
    "omitted_steps": {
      "items": {
        "required": [
          "id",
          "outcome",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "not_selected",
        "incomplete"
      ]
    },
    "plan": {
      "$ref": "scenery.validation.plan.schema.json"
    },
    "producer": {
      "$ref": "scenery.cli.schema.json#/$defs/producer"
    },
    "run": {
      "additionalProperties": false,
      "properties": {
        "archive_path": {
          "type": "string"
        },
        "final_input_revision": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "identity_error": {
          "type": "string"
        },
        "input_revision": {
          "type": "string"
        },
        "input_scope": {
          "type": "string"
        },
        "inputs_stable": {
          "type": "boolean"
        },
        "source_commit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "source_commit",
        "input_revision",
        "final_input_revision",
        "input_scope",
        "inputs_stable"
      ],
      "type": "object"
    },
    "selected_steps": {
      "minimum": 0,
      "type": "integer"
    },
    "spec_revision": {
      "$ref": "scenery.cli.schema.json#/$defs/revision"
    },
    "unknown_stages": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "additionalProperties": false
}
