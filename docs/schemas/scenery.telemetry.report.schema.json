{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.telemetry.report.schema.json",
  "title": "scenery telemetry report",
  "type": "object",
  "required": [
    "kind",
    "schema_revision",
    "window",
    "sources",
    "findings",
    "cli",
    "builds"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "scenery.telemetry.report"
    },
    "schema_revision": {
      "const": "sha256:ac55c3e57674c46a972b84b2014e0211facc68c3bacf66b580b14f457dbee84d"
    },
    "window": {
      "type": "object",
      "required": [
        "until"
      ],
      "additionalProperties": false,
      "properties": {
        "since": {
          "type": "string",
          "format": "date-time"
        },
        "until": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "sources": {
      "type": "object",
      "required": [
        "cli_records",
        "cli_invalid_records",
        "supervisor_logs",
        "supervisor_logs_partial",
        "supervisor_logs_failed",
        "supervisor_invalid_records",
        "agent_transcripts",
        "claude_sessions",
        "codex_sessions",
        "live_state_checked",
        "live_state_unavailable",
        "supervisor_rotated_sessions",
        "cli_files",
        "supervisor_files"
      ],
      "additionalProperties": false,
      "properties": {
        "cli_records": {
          "type": "integer",
          "minimum": 0
        },
        "cli_invalid_records": {
          "type": "integer",
          "minimum": 0
        },
        "supervisor_logs": {
          "type": "integer",
          "minimum": 0
        },
        "supervisor_logs_partial": {
          "type": "integer",
          "minimum": 0
        },
        "supervisor_logs_failed": {
          "type": "integer",
          "minimum": 0
        },
        "supervisor_invalid_records": {
          "type": "integer",
          "minimum": 0
        },
        "agent_transcripts": {
          "type": "boolean"
        },
        "claude_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "codex_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "transcripts": {
          "$ref": "#/$defs/transcriptSources"
        },
        "live_state_checked": {
          "type": "boolean"
        },
        "live_state_unavailable": {
          "type": "integer",
          "minimum": 0
        },
        "supervisor_rotated_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "cli_files": {
          "items": {
            "$ref": "#/$defs/cliFileCoverage"
          },
          "type": "array"
        },
        "supervisor_files": {
          "description": "Logical session log coverage. Open segments are bounded at their observed size; first/last are retained event cutoffs, not proof of continuous coverage.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "first": {
                "type": "string"
              },
              "in_window": {
                "minimum": 0,
                "type": "integer"
              },
              "invalid": {
                "minimum": 0,
                "type": "integer"
              },
              "last": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "records": {
                "minimum": 0,
                "type": "integer"
              },
              "segments": {
                "minimum": 0,
                "type": "integer"
              },
              "snapshot_bytes": {
                "minimum": 0,
                "type": "integer"
              },
              "status": {
                "enum": [
                  "complete",
                  "partial",
                  "unreadable",
                  "missing"
                ]
              }
            },
            "required": [
              "path",
              "status",
              "snapshot_bytes",
              "segments",
              "records",
              "in_window",
              "invalid"
            ],
            "type": "object"
          },
          "type": "array"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "cli": {
      "type": "object",
