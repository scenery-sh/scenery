        },
        "failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "p50_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "p95_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "id": {
