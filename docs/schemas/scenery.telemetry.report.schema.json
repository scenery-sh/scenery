      "additionalProperties": false,
      "properties": {
        "records": {
          "type": "integer",
          "minimum": 0
        },
        "failures": {
          "type": "integer",
          "minimum": 0
        },
        "unattributed": {
          "type": "integer",
          "minimum": 0
        },
        "unversioned": {
          "type": "integer",
          "minimum": 0
        },
        "startup": {
          "$ref": "#/$defs/timing"
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commandTiming"
          }
        },
        "apps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/appTiming"
          }
        },
        "failure_bursts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failureBurst"
          }
        },
        "producers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/count"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/count"
          }
        },
        "identified_invocations": {
          "type": "integer",
          "minimum": 0
        },
        "cohorts": {
          "items": {
            "$ref": "#/$defs/cliCohort"
          },
          "type": "array"
        },
        "purposes": {
          "items": {
            "$ref": "#/$defs/count"
          },
          "type": "array"
        }
      }
    },
    "builds": {
      "type": "object",
      "required": [
        "sessions",
        "rebuilds",
        "initial_builds",
        "worktrees",
        "rebuild_steps",
        "failure_causes",
        "unmatched_errors",
        "failure_streaks",
        "blocks",
        "active_blocks",
        "prevented_builds",
        "superseded",
        "observed_change_to_first_response",
        "initial_failure_causes",
        "rebuild_failure_causes",
        "unstarted_error_causes",
        "transaction_waits",
        "deferred_candidates",
        "first_header_observations",
        "first_header_observation_count",
        "startup_phases",
        "phase_boundary",
        "observability_states",
        "cache_work"
      ],
      "additionalProperties": false,
      "properties": {
        "sessions": {
          "type": "integer",
          "minimum": 0
        },
        "rebuilds": {
          "$ref": "#/$defs/timing"
        },
        "initial_builds": {
          "$ref": "#/$defs/timing"
        },
        "worktrees": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/worktreeBuilds"
          }
        },
        "rebuild_steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stepTiming"
          }
        },
        "failure_causes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/count"
          }
        },
        "unmatched_errors": {
          "type": "integer",
          "minimum": 0
        },
        "failure_streaks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failureStreak"
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/buildBlock"
          }
        },
        "active_blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/buildBlock"
          }
        },
        "prevented_builds": {
          "type": "integer",
          "minimum": 0
        },
        "superseded": {
          "type": "integer",
          "minimum": 0
        },
        "observed_change_to_first_response": {
          "$ref": "#/$defs/timing"
        },
        "cache_work": {
          "items": {
            "required": [
              "layer",
              "edit_class",
              "cache",
              "reason",
              "samples",
              "accumulated_ms",
              "boundary"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "deferred_candidates": {
          "minimum": 0,
          "type": "integer"
        },
        "first_header_observation_count": {
          "minimum": 0,
          "type": "integer"
        },
        "first_header_observations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "app_root": {
                "type": "string"
              },
              "at": {
                "type": "string"
              },
              "build_input_digest": {
                "type": "string"
              },
              "duration_ms": {
                "minimum": 0,
                "type": "integer"
              },
              "generation": {
                "minimum": 0,
                "type": "integer"
              },
              "implementation_revision": {
                "type": "string"
              },
              "initial": {
                "type": "boolean"
              },
              "observed_at": {
                "type": "string"
              },
              "operation_id": {
                "type": "string"
              },
              "status": {
                "maximum": 499,
                "minimum": 200,
                "type": "integer"
              }
            },
            "required": [
              "app_root",
              "operation_id",
              "observed_at",
              "initial",
              "at",
              "generation",
              "implementation_revision",
              "build_input_digest",
              "status",
              "duration_ms"
            ],
            "type": "object"
          },
          "maxItems": 200,
          "type": "array"
        },
        "initial_failure_causes": {
          "items": {
            "$ref": "#/$defs/count"
          },
          "type": "array"
        },
        "observability_states": {
          "items": {
            "$ref": "#/$defs/count"
          },
          "type": "array"
        },
        "phase_boundary": {
          "type": "string"
        },
        "rebuild_failure_causes": {
          "items": {
            "$ref": "#/$defs/count"
          },
          "type": "array"
        },
        "startup_phases": {
          "items": {
            "$ref": "#/$defs/stepTiming"
          },
          "type": "array"
        },
        "transaction_waits": {
          "minimum": 0,
          "type": "integer"
        },
        "unstarted_error_causes": {
          "items": {
            "$ref": "#/$defs/count"
          },
          "type": "array"
        }
      }
    },
    "agents": {
      "type": "object",
      "required": [
        "claude_sessions",
        "codex_sessions",
        "tool_calls",
        "tool_errors",
        "tool_error_kinds",
        "scenery_invocations",
        "scenery_commands",
        "scenery_outcome_unknown",
        "scenery_failed",
        "scenery_attributable",
        "scenery_attributable_failed",
        "commands",
        "failure_classes",
        "rejected_inputs"
      ],
      "additionalProperties": false,
      "properties": {
        "claude_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "codex_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "tool_errors": {
          "type": "integer",
          "minimum": 0
        },
        "tool_error_kinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/count"
          }
        },
        "scenery_invocations": {
          "type": "integer",
          "minimum": 0
        },
        "scenery_commands": {
          "type": "integer",
          "minimum": 0
        },
        "scenery_outcome_unknown": {
          "type": "integer",
          "minimum": 0
        },
        "scenery_failed": {
          "type": "integer",
          "minimum": 0
        },
        "scenery_attributable": {
          "type": "integer",
          "minimum": 0
        },
        "scenery_attributable_failed": {
          "type": "integer",
          "minimum": 0
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agentCommand"
          }
        },
        "failure_classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/count"
          }
        },
        "rejected_inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/count"
          }
        }
      }
    }
  },
  "$defs": {
    "timing": {
      "type": "object",
      "required": [
        "count",
        "failure_count",
        "p50_ms",
        "p95_ms",
        "percentile_sample_count"
      ],
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "p50_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "p95_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "percentile_sample_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "count": {
      "type": "object",
