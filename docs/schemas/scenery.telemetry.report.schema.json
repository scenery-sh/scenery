{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.telemetry.report.schema.json",
  "title": "scenery telemetry report",
  "type": "object",
  "required": [
    "kind",
    "schema_revision",
    "window",
    "sources",
    "findings",
    "cli",
    "builds"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "scenery.telemetry.report"
    },
    "schema_revision": {
      "const": "sha256:d95d8bf338ad20eb8c24036b10f6322b074467f984c864417a94fccfce2387b8"
    },
    "window": {
      "type": "object",
      "required": [
        "until"
      ],
      "additionalProperties": false,
      "properties": {
        "since": {
          "type": "string",
          "format": "date-time"
        },
        "until": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "sources": {
      "type": "object",
      "required": [
        "cli_records",
        "cli_invalid_records",
        "supervisor_logs",
        "supervisor_logs_partial",
        "supervisor_logs_failed",
        "supervisor_invalid_records",
        "live_state_checked",
        "live_state_unavailable",
        "supervisor_rotated_sessions",
        "cli_files",
        "supervisor_files"
      ],
      "additionalProperties": false,
      "properties": {
        "cli_records": {
          "type": "integer",
          "minimum": 0
        },
        "cli_invalid_records": {
          "type": "integer",
          "minimum": 0
        },
        "supervisor_logs": {
          "type": "integer",
          "minimum": 0
        },
        "supervisor_logs_partial": {
          "type": "integer",
          "minimum": 0
        },
        "supervisor_logs_failed": {
          "type": "integer",
          "minimum": 0
        },
        "supervisor_invalid_records": {
          "type": "integer",
          "minimum": 0
        },
        "live_state_checked": {
          "type": "boolean"
        },
        "live_state_unavailable": {
          "type": "integer",
          "minimum": 0
        },
        "supervisor_rotated_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "cli_files": {
          "items": {
            "$ref": "#/$defs/cliFileCoverage"
          },
          "type": "array"
        },
        "supervisor_files": {
          "description": "Logical session coverage over unique opened descriptor extents. A premature segment EOF stops parsing across the gap. Byte coverage is not an atomic content snapshot or complete historical retention.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "first": {
                "type": "string"
              },
              "in_window": {
                "minimum": 0,
                "type": "integer"
              },
              "invalid": {
                "minimum": 0,
                "type": "integer"
              },
              "last": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "records": {
                "minimum": 0,
                "type": "integer"
              },
              "segments": {
                "minimum": 0,
                "type": "integer"
              },
              "snapshot_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9223372036854775807,
                "description": "Captured regular-file extent, or null if any selected extent is unknown. Zero is a known empty extent."
              },
              "status": {
                "enum": [
                  "complete",
                  "partial",
                  "unreadable",
                  "missing"
                ]
              },
              "read_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807,
                "description": "Physical bytes returned by descriptor-bound readers, including invalid, ignored and skipped oversized input."
              }
            },
            "required": [
              "path",
              "status",
              "snapshot_bytes",
              "segments",
              "records",
              "in_window",
              "invalid",
              "read_bytes"
            ],
            "type": "object"
          },
          "type": "array"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "cli": {
      "type": "object",
      "required": [
        "records",
        "failures",
        "unattributed",
        "unversioned",
        "startup",
        "commands",
        "apps",
        "failure_bursts",
        "producers",
        "diagnostics",
        "identified_invocations",
        "uptime_records",
        "error_categories",
        "events",
        "purposes",
        "callers",
        "rejected_tokens",
        "proxy_faults",
        "runtime_faults",
        "worker_faults",
        "noop_rebuilds",
        "daily",
        "producer_trends",
        "cohorts"
      ],
      "additionalProperties": false,
      "properties": {
        "records": {
          "type": "integer",
          "minimum": 0
        },
        "failures": {
          "type": "integer",
          "minimum": 0
        },
        "unattributed": {
          "type": "integer",
          "minimum": 0
        },
        "unversioned": {
          "type": "integer",
          "minimum": 0
        },
        "startup": {
          "$ref": "#/$defs/timing"
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commandTiming"
          }
        },
        "apps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/appTiming"
          }
        },
        "failure_bursts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failureBurst"
          }
        },
        "producers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/count"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/count"
          }
        },
        "uptime_records": {"type": "integer", "minimum": 0},
        "error_categories": {"type": "array", "items": {"$ref": "#/$defs/count"}},
        "events": {"type": "array", "maxItems": 100, "items": {"$ref": "scenery.telemetry.event.schema.json"}},
        "identified_invocations": {
          "type": "integer",
          "minimum": 0
        },
        "cohorts": {
          "items": {
            "$ref": "#/$defs/cliCohort"
          },
          "type": "array"
        },
        "purposes": {
          "items": {
            "$ref": "#/$defs/count"
          },
          "type": "array"
        },
        "callers": {
          "items": {
            "$ref": "#/$defs/count"
          },
          "type": "array"
        },
        "rejected_tokens": {
          "items": {
            "$ref": "#/$defs/count"
          },
          "type": "array"
        },
        "proxy_faults": {
          "items": {
            "$ref": "#/$defs/count"
          },
          "type": "array"
        },
        "runtime_faults": {
          "items": {
            "$ref": "#/$defs/count"
          },
          "type": "array"
        },
        "worker_faults": {
          "items": {
            "$ref": "#/$defs/count"
          },
          "type": "array"
        },
        "noop_rebuilds": {
          "type": "integer",
          "minimum": 0
        },
        "daily": {
          "items": {
            "$ref": "#/$defs/dailySummary"
          },
          "type": "array"
        },
        "producer_trends": {
          "items": {
            "$ref": "#/$defs/producerTrend"
          },
          "type": "array"
        }
      }
    },
    "builds": {
      "type": "object",
      "required": [
        "sessions",
        "rebuilds",
        "initial_builds",
        "worktrees",
        "rebuild_steps",
        "failure_causes",
        "unmatched_errors",
        "failure_streaks",
        "blocks",
        "active_blocks",
        "prevented_builds",
        "superseded",
        "observed_change_to_first_response",
        "initial_failure_causes",
        "rebuild_failure_causes",
        "unstarted_error_causes",
        "transaction_waits",
        "deferred_candidates",
        "first_header_observations",
        "first_header_observation_count",
        "startup_phases",
        "phase_boundary",
        "observability_states",
        "cache_work"
      ],
      "additionalProperties": false,
      "properties": {
        "sessions": {
          "type": "integer",
          "minimum": 0
        },
        "rebuilds": {
          "$ref": "#/$defs/timing"
        },
        "initial_builds": {
          "$ref": "#/$defs/timing"
        },
        "worktrees": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/worktreeBuilds"
          }
        },
        "rebuild_steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stepTiming"
          }
        },
        "failure_causes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/count"
          }
        },
        "unmatched_errors": {
          "type": "integer",
          "minimum": 0
        },
        "failure_streaks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failureStreak"
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/buildBlock"
          }
        },
        "active_blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/buildBlock"
          }
        },
        "prevented_builds": {
          "type": "integer",
          "minimum": 0
        },
        "superseded": {
          "type": "integer",
          "minimum": 0
        },
        "observed_change_to_first_response": {
          "$ref": "#/$defs/timing"
        },
        "cache_work": {
          "items": {
            "required": [
              "layer",
              "edit_class",
              "cache",
              "reason",
              "samples",
              "accumulated_ms",
              "boundary",
              "timing_sample_count"
            ],
            "type": "object",
            "properties": {
              "samples": {
                "type": "integer",
                "minimum": 0
              },
              "timing_sample_count": {
                "type": "integer",
                "minimum": 0
              },
              "accumulated_ms": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          },
          "type": "array"
        },
        "deferred_candidates": {
          "minimum": 0,
          "type": "integer"
        },
        "first_header_observation_count": {
          "minimum": 0,
          "type": "integer"
        },
        "first_header_observations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "app_root": {
                "type": "string"
              },
              "at": {
                "type": "string"
              },
              "build_input_digest": {
                "type": "string"
              },
              "duration_ms": {
                "minimum": 0,
                "type": "integer"
              },
              "generation": {
                "minimum": 0,
                "type": "integer"
              },
              "implementation_revision": {
                "type": "string"
              },
              "initial": {
                "type": "boolean"
              },
              "observed_at": {
                "type": "string"
              },
              "operation_id": {
                "type": "string"
              },
              "status": {
                "maximum": 499,
                "minimum": 200,
                "type": "integer"
              }
            },
            "required": [
              "app_root",
              "operation_id",
              "observed_at",
              "initial",
              "at",
              "generation",
              "implementation_revision",
              "build_input_digest",
              "status",
              "duration_ms"
            ],
            "type": "object"
          },
          "maxItems": 200,
          "type": "array"
        },
        "initial_failure_causes": {
          "items": {
            "$ref": "#/$defs/count"
          },
          "type": "array"
        },
        "observability_states": {
          "items": {
            "$ref": "#/$defs/count"
          },
          "type": "array"
        },
        "phase_boundary": {
          "type": "string"
        },
        "rebuild_failure_causes": {
          "items": {
            "$ref": "#/$defs/count"
          },
          "type": "array"
        },
        "startup_phases": {
          "items": {
            "$ref": "#/$defs/stepTiming"
          },
          "type": "array"
        },
        "transaction_waits": {
          "minimum": 0,
          "type": "integer"
        },
        "unstarted_error_causes": {
          "items": {
            "$ref": "#/$defs/count"
          },
          "type": "array"
        }
      }
    }
  },
  "$defs": {
    "timing": {
      "type": "object",
      "required": [
        "count",
        "failure_count",
        "p50_ms",
        "p95_ms",
        "percentile_sample_count"
      ],
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "p50_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "p95_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "percentile_sample_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "count": {
      "type": "object",
      "required": [
        "name",
        "count"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "severity",
        "code",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "severity": {
          "enum": [
            "critical",
            "warning",
            "info"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "commandTiming": {
      "type": "object",
      "required": [
        "command",
        "count",
        "failure_count",
        "p50_ms",
        "p95_ms",
        "percentile_sample_count"
      ],
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "p50_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "p95_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "percentile_sample_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "appTiming": {
      "type": "object",
      "required": [
        "id",
        "name",
        "count",
        "failure_count",
        "p50_ms",
        "p95_ms",
        "percentile_sample_count"
      ],
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "p50_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "p95_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "percentile_sample_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "stepTiming": {
      "type": "object",
      "required": [
        "step",
        "count",
        "failure_count",
        "p50_ms",
        "p95_ms",
        "percentile_sample_count"
      ],
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "p50_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "p95_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "step": {
          "type": "string",
          "minLength": 1
        },
        "percentile_sample_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "failureBurst": {
      "type": "object",
      "required": [
        "command",
        "exit_code",
        "count",
        "first",
        "last",
        "peak_per_hour"
      ],
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "first": {
          "type": "string",
          "format": "date-time"
        },
        "last": {
          "type": "string",
          "format": "date-time"
        },
        "peak_per_hour": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "worktreeBuilds": {
      "type": "object",
      "required": [
        "app_root",
        "app_name",
        "sessions",
        "rebuilds",
        "initial_builds",
        "longest_failure_streak"
      ],
      "additionalProperties": false,
      "properties": {
        "app_root": {
          "type": "string",
          "minLength": 1
        },
        "app_name": {
          "type": "string"
        },
        "sessions": {
          "type": "integer",
          "minimum": 0
        },
        "rebuilds": {
          "$ref": "#/$defs/timing"
        },
        "initial_builds": {
          "$ref": "#/$defs/timing"
        },
        "longest_failure_streak": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "failureStreak": {
      "type": "object",
      "required": [
        "app_root",
        "cause",
        "count",
        "first",
        "last"
      ],
      "additionalProperties": false,
      "properties": {
        "app_root": {
          "type": "string",
          "minLength": 1
        },
        "cause": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "first": {
          "type": "string",
          "format": "date-time"
        },
        "last": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "dailySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "count",
        "failure_count",
        "startup_count",
        "startup_failure_count",
        "startup_p50_ms"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "startup_count": {
          "type": "integer",
          "minimum": 0
        },
        "startup_failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "startup_p50_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "producerTrend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "first_at",
        "last_at",
        "count",
        "failure_count",
        "startup_count",
        "startup_failure_count",
        "startup_p50_ms"
      ],
      "properties": {
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "first_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_at": {
          "type": "string",
          "format": "date-time"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "startup_count": {
          "type": "integer",
          "minimum": 0
        },
        "startup_failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "startup_p50_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "buildBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app_root",
        "reason",
        "cause",
        "since",
        "last_seen",
        "duration_ms",
        "prevented_builds"
      ],
      "properties": {
        "app_root": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "cause": {
          "type": "string"
        },
        "since": {
          "type": "string"
        },
        "last_seen": {
          "type": "string"
        },
        "ended_at": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "prevented_builds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cliCohort": {
      "additionalProperties": false,
      "properties": {
        "app_id": {
          "type": "string"
        },
        "app_name": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "count": {
          "minimum": 0,
          "type": "integer"
        },
        "dirty": {
          "enum": [
            "unknown",
            "clean",
            "dirty"
          ]
        },
        "failure_count": {
          "minimum": 0,
          "type": "integer"
        },
        "measurement": {
          "enum": [
            "completion",
            "startup"
          ]
        },
        "p50_ms": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "p95_ms": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "percentile_sample_count": {
          "minimum": 0,
          "type": "integer"
        },
        "producer": {
          "type": "string"
        },
        "purpose": {
          "enum": [
            "unknown",
            "development",
            "verification",
            "release"
          ]
        }
      },
      "required": [
        "count",
        "failure_count",
        "p50_ms",
        "p95_ms",
        "percentile_sample_count",
        "app_id",
