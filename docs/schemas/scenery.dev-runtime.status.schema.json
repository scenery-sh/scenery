{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scenery.dev-runtime.status",
  "description": "Result of the development runtime RPC method `status` (docs/local-contract.md#development-runtime-rpc).",
  "type": "object",
  "required": [
    "kind",
    "schema_revision",
    "app_id",
    "app_root",
    "running",
    "compiling",
    "routes",
    "service_processes",
    "source_freshness"
  ],
  "properties": {
    "kind": {
      "const": "scenery.dev-runtime.status"
    },
    "schema_revision": {
      "const": "sha256:93b6ee76b4ef4b5626531207a014791d0c56bbc38419533fa0bb1e505ffd2d2c"
    },
    "app_id": {
      "type": "string",
      "description": "Session route identity; the app_id argument of the other development runtime methods."
    },
    "base_app_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "app_root": {
      "type": "string"
    },
    "running": {
      "type": "boolean"
    },
    "session_status": {
      "type": "string",
      "description": "Session health such as running, degraded, stale, compile-error or stopped; only running is healthy."
    },
    "session_status_reason": {
      "type": "string"
    },
    "compiling": {
      "type": "boolean"
    },
    "compile_error": {
      "type": "string"
    },
    "pid": {
      "type": "string"
    },
    "routes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "service_processes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/serviceProcess"
      }
    },
    "observability": {
      "$ref": "#/$defs/observability"
    },
    "build_block": {
      "description": "Present while builds are blocked by a cause no ordinary edit resolves; the runtime keeps serving its last good generation.",
      "type": "object",
      "required": [
        "reason",
        "cause",
        "since",
        "prevented_builds"
      ],
      "additionalProperties": false,
      "properties": {
        "reason": {
          "enum": [
            "framework_mismatch",
            "migration_pending",
            "seed_changed",
            "generated_clients_stale"
          ]
        },
        "cause": {
          "type": "string"
        },
        "since": {
          "type": "string",
          "format": "date-time"
        },
        "prevented_builds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "serving": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "pid",
        "contract_revision",
        "implementation_revision",
        "build_input_digest",
        "framework_source_digest",
        "source_snapshot_digest",
        "published_at"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "pid": {
          "type": "string"
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "contract_revision": {
          "type": "string"
        },
        "implementation_revision": {
          "type": "string"
        },
        "build_input_digest": {
          "type": "string"
        },
        "framework_source_digest": {
          "type": "string"
        },
        "source_snapshot_digest": {
          "type": "string"
        }
      }
    },
    "source_freshness": {
      "enum": [
        "current",
        "stale",
        "source_missing",
        "blocked",
        "transaction_pending",
        "unknown"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "serviceProcess": {
      "type": "object",
      "required": [
        "name",
        "state"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "pid": {
          "type": "string"
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "implementation_revision": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "observability": {
      "type": "object",
      "required": [
        "enabled",
        "metrics",
        "logs",
        "traces",
        "export"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        },
        "metrics": {
          "$ref": "#/$defs/signal"
        },
        "logs": {
          "$ref": "#/$defs/signal"
        },
        "traces": {
          "$ref": "#/$defs/signal"
        },
        "export": {
          "description": "Telemetry not delivered to the observability backend since the runtime started: runtime admission and failed-batch drops carried by a later successful batch, reports rejected by intake byte limits or dropped because the bounded export queue was full, and exports that failed, one for each report and signal.",
          "type": "object",
          "required": [
            "dropped",
            "failed"
          ],
          "additionalProperties": false,
          "properties": {
            "dropped": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "additionalProperties": false
    },
    "signal": {
      "type": "object",
      "required": [
        "enabled",
        "available",
        "status"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "available": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "$id": "https://scenery.sh/schemas/scenery.dev-runtime.status.schema.json"
}
