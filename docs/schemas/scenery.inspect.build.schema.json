{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.inspect.build.schema.json",
  "title": "scenery.inspect.build",
  "type": "object",
  "required": [
    "kind",
    "schema_revision",
    "app",
    "build"
  ],
  "properties": {
    "kind": {
      "const": "scenery.inspect.build"
    },
    "schema_revision": {
      "const": "sha256:f34b323c11b11faa7c4000f779549ac859eb689c4d0f6b6073473d41924b6df3"
    },
    "app": {
      "$ref": "#/$defs/appRef"
    },
    "build": {
      "type": "object",
      "required": [
        "workspace_dir",
        "binary_path",
        "workspace_exists",
        "binary_exists",
        "build_state_path",
        "build_state_exists",
        "metadata_present",
        "api_encoding_present",
        "source_file_count",
        "generated_file_count"
      ],
      "properties": {
        "workspace_dir": {
          "type": "string"
        },
        "binary_path": {
          "type": "string"
        },
        "workspace_exists": {
          "type": "boolean"
        },
        "binary_exists": {
          "type": "boolean"
        },
        "build_state_path": {
          "type": "string"
        },
        "build_state_exists": {
          "type": "boolean"
        },
        "build_state_version": {
          "type": "string"
        },
        "dependency_fingerprint": {
          "type": "string"
        },
        "graph_fingerprint": {
          "type": "string"
        },
        "metadata_present": {
          "type": "boolean"
        },
        "api_encoding_present": {
          "type": "boolean"
        },
        "source_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "generated_file_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "candidate_identity": {
      "$ref": "scenery.build.result.schema.json#/properties/candidate_identity"
    },
    "verification_module_source": {
      "type": "string",
      "minLength": 1
    },
    "verification_module_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "appRef": {
      "type": "object",
      "required": [
        "name",
        "root",
        "config_path"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "root": {
          "type": "string"
        },
        "config_path": {
          "type": "string"
        },
        "module_path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
