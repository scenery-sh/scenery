{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.inspect.generators.schema.json",
  "title": "scenery.inspect.generators",
  "type": "object",
  "required": [
    "kind",
    "schema_revision",
    "app",
    "generators",
    "db_artifacts",
    "nodes"
  ],
  "properties": {
    "kind": {
      "const": "scenery.inspect.generators"
    },
    "schema_revision": {
      "const": "sha256:93255420d92ccf5c562158d363957f10461ca58978263582153c347b82331f85"
    },
    "app": {
      "$ref": "#/$defs/appRef"
    },
    "generators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/generator"
      }
    },
    "db_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dbArtifact"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lifecycleNode"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "appRef": {
      "type": "object",
      "required": [
        "name",
        "root",
        "config_path"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "root": {
          "type": "string"
        },
        "config_path": {
          "type": "string"
        },
        "module_path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "generator": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tool": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "dbArtifact": {
      "type": "object",
      "required": [
        "service",
        "kind",
        "role",
        "path"
      ],
      "properties": {
        "service": {
          "type": "string"
        },
        "engine": {
          "type": "string",
          "enum": [
            "postgres"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "schema-source",
            "query",
            "generated-schema",
            "seed"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "schema",
            "query-generation-input",
            "generated-source",
            "initial-data"
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "lifecycleReference": {
      "type": "object",
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "producer": {
          "type": "string"
        },
        "ownership": {
          "enum": [
            "private",
            "managed",
            "external"
          ]
        }
      },
      "additionalProperties": false
    },
    "lifecycleNode": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "dependencies",
        "inputs",
        "outputs",
        "cache_policy",
        "effects"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lifecycleReference"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lifecycleReference"
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "cache_policy": {
          "enum": [
            "reusable",
            "current_validation",
            "external_effect"
          ]
        },
        "effects": {
          "type": "array",
          "items": {
            "enum": [
              "source.read",
              "cache.write",
              "artifacts.publish",
              "scratch.use",
              "database.mutate",
              "runtime.control"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
