{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.contract-cli.response.schema.json",
  "title": "scenery.contract-cli.response",
  "type": "object",
  "required": [
    "kind",
    "schema_revision",
    "spec_revision",
    "producer"
  ],
  "properties": {
    "kind": {
      "const": "scenery.contract-cli.response"
    },
    "schema_revision": {
      "const": "sha256:83fdacc3279a1aec536d13b8efcae59ceb8346126857991d494a857368cf9e01"
    },
    "spec_revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "producer": {
      "type": "object"
    },
    "outcome": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "payload"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "payload": {}
      },
      "additionalProperties": false
    },
    "problem": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "invocation": {
      "type": "object",
      "required": [
        "invocation_id"
      ],
      "additionalProperties": false,
      "properties": {
        "invocation_id": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      }
    }
  },
  "additionalProperties": false
}
