{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scenery.prune",
  "type": "object",
  "required": [
    "kind",
    "schema_revision",
    "cutoff",
    "pruned",
    "skipped",
    "db_cleanup",
    "state_cleanup",
    "build_cache_cleanup",
    "dev_events_pruned",
    "dev_sources_pruned",
    "resources",
    "build_cache",
    "preview"
  ],
  "properties": {
    "kind": {
      "const": "scenery.prune"
    },
    "schema_revision": {
      "const": "sha256:212df0b20151171c7ec70d521698c5e66146b55c17f84719d2b919cdd63060a3"
    },
    "cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "pruned": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "db_cleanup": {
      "type": "boolean"
    },
    "state_cleanup": {
      "type": "boolean"
    },
    "build_cache_cleanup": {
      "type": "boolean"
    },
    "dev_events_pruned": {
      "type": "integer",
      "minimum": 0
    },
    "dev_sources_pruned": {
      "type": "integer",
      "minimum": 0
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "app_root",
          "scope",
          "resource_id",
          "container",
          "volume"
        ],
        "properties": {
          "app_root": {
            "type": "string"
          },
          "scope": {
            "const": "worktree-cluster"
          },
          "resource_id": {
            "type": "string"
          },
          "container": {
            "type": "string"
          },
          "volume": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "build_cache": {
      "description": "Disposable build state the prune considered; null unless --build-cache was requested.",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "cache_root",
        "workspaces",
        "framework",
        "bytes_reclaimed"
      ],
      "properties": {
        "cache_root": {
          "type": "string"
        },
        "workspaces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "updated_at",
              "bytes",
              "removed",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "app_root": {
                "type": "string"
              },
              "app_name": {
                "type": "string"
              },
              "updated_at": {
                "type": "string"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "removed": {
                "type": "boolean"
              },
              "reason": {
                "enum": [
                  "app_root_missing",
                  "stale",
                  "locked",
                  "active",
                  "recent",
                  "kept"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "framework": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "kind",
              "bytes",
              "removed",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "source",
                  "producer",
                  "staging"
                ]
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "removed": {
                "type": "boolean"
              },
              "reason": {
                "enum": [
                  "unselected",
                  "selected",
                  "runtime",
                  "interrupted",
                  "locked"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "bytes_reclaimed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "preview": {
      "type": "boolean"
    },
    "inventory": {
      "type": "array",
      "description": "Read-only retained directories and separately owned resources, including invalid metadata. Bytes count logical regular-file contents; complete=false marks unmeasured content/volumes. Preview allocates no runtime/data and removes nothing.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "app_root",
          "path",
          "kind",
          "bytes",
          "complete",
          "reclaimable",
          "reason"
        ],
        "properties": {
          "app_root": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "retained_worktree",
              "supervisor_logs",
              "database_volume",
              "session_state",
              "build_workspace",
              "framework_state"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "complete": {
            "type": "boolean"
          },
          "reclaimable": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$id": "https://scenery.sh/schemas/scenery.prune.schema.json"
}
