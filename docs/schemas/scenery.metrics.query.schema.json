{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.metrics.query.schema.json",
  "title": "scenery.metrics.query",
  "type": "object",
  "required": [
    "kind",
    "schema_revision",
    "scope",
    "backend",
    "query",
    "result_type",
    "series"
  ],
  "properties": {
    "kind": {
      "const": "scenery.metrics.query"
    },
    "schema_revision": {
      "const": "sha256:a4583fb699388059b33c0f15cc24b547b698a8454521c27cc922ee182383dfae"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "backend": {
      "$ref": "#/$defs/backend"
    },
    "query": {
      "$ref": "#/$defs/query"
    },
    "result_type": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "series": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/series"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "scope": {
      "type": "object",
      "required": [
        "app_id",
        "session_id",
        "app_root",
        "app_root_hash",
        "enforced"
      ],
      "properties": {
        "app_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "app_root": {
          "type": "string"
        },
        "app_root_hash": {
          "type": "string"
        },
        "worktree": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "enforced": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "backend": {
      "type": "object",
      "required": [
        "kind",
        "dialect",
        "ready"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "dialect": {
          "type": "string"
        },
        "base_url": {
          "type": "string"
        },
        "ready": {
          "type": "boolean"
        },
        "query_path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "required": [
        "promql",
        "mode"
      ],
      "properties": {
        "promql": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "range",
            "instant"
          ]
        },
        "since": {
          "type": "string"
        },
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "step": {
          "type": "string"
        },
        "timeout": {
          "type": "string"
        },
        "limit": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "sample": {
      "type": "object",
      "required": [
        "time",
        "value"
      ],
      "properties": {
        "time": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "series": {
      "type": "object",
      "required": [
        "metric"
      ],
      "properties": {
        "metric": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "value": {
          "$ref": "#/$defs/sample"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sample"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
