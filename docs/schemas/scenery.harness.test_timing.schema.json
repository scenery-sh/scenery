{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenery.sh/schemas/scenery.harness.test_timing.schema.json",
  "title": "scenery harness test timing report",
  "type": "object",
  "required": [
    "kind",
    "schema_revision",
    "command",
    "total_seconds",
    "packages",
    "budgets"
  ],
  "properties": {
    "kind": {
      "const": "scenery.harness.test_timing"
    },
    "schema_revision": {
      "const": "sha256:73231c3fb87a0790d678879fec827f095f584d8618755dbf10f4fcc4fddad3fa"
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "total_seconds": {
      "type": "number"
    },
    "confirmation_seconds": {
      "type": "number"
    },
    "test_binaries": {
      "type": "object",
      "required": [
        "manifest_hit",
        "prepare_seconds",
        "built_count"
      ],
      "properties": {
        "manifest_hit": {
          "type": "boolean"
        },
        "prepare_seconds": {
          "type": "number"
        },
        "list_seconds": {
          "type": "number"
        },
        "build_seconds": {
          "type": "number"
        },
        "built_count": {
          "type": "integer",
          "minimum": 0
        },
        "builds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "package",
              "build_id",
              "seconds"
            ],
            "properties": {
              "package": {
                "type": "string"
              },
              "build_id": {
                "type": "string"
              },
              "seconds": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package_timing"
      }
    },
    "slow_tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/test_timing"
      }
    },
    "observed_slow_tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/test_timing"
      }
    },
    "deferred_confirmations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "package",
          "seconds",
          "baseline_seconds",
          "reason"
        ],
        "properties": {
          "package": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "seconds": {
            "type": "number"
          },
          "baseline_seconds": {
            "type": "number"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "budgets": {
      "type": "object",
      "required": [
        "total_seconds",
        "package_seconds",
        "test_seconds",
        "mode"
      ],
      "properties": {
        "lane": {
          "type": "string",
          "enum": [
            "cached",
            "fresh",
            "release"
          ]
        },
        "target_seconds": {
          "type": "number"
        },
        "total_seconds": {
          "type": "number"
        },
        "package_seconds": {
          "type": "number"
        },
        "package_overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "test_seconds": {
          "type": "number"
        },
        "confirmation_runs": {
          "type": "integer",
          "minimum": 1
        },
        "confirmation_scope": {
          "type": "string",
          "enum": [
            "regressions",
            "all"
          ]
        },
        "mode": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "package_timing": {
      "type": "object",
      "required": [
        "package",
        "seconds"
      ],
      "properties": {
        "package": {
          "type": "string"
        },
        "seconds": {
          "type": "number"
        },
        "budget_seconds": {
          "type": "number"
        },
        "isolated_seconds": {
          "type": "number"
        },
        "slow_tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/test_timing"
          }
        }
      },
      "additionalProperties": false
    },
    "test_timing": {
      "type": "object",
      "required": [
        "name",
        "package",
        "seconds"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "seconds": {
          "type": "number"
        },
        "budget_seconds": {
          "type": "number"
        },
        "isolated_samples": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "isolated_median_seconds": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  }
}
